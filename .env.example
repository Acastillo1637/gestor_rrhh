# Copiar a .env y reemplazar la clave por una generada con
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
CLAVE_SECRETA_DJANGO=

# Desarrollo local: si. Producción con HTTPS: no.
MODO_DEPURACION=si
DOMINIOS_PERMITIDOS=localhost,127.0.0.1,[::1]

# Credenciales de PostgreSQL online; nunca incluir valores reales en Git.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
